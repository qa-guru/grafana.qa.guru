      "targets": [
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br.*|docker.*|tunl.*\"}[5m])", "legendFormat": "rx {{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br.*|docker.*|tunl.*\"}[5m])", "legendFormat": "tx {{device}}", "refId": "B" }
      ],
      "title": "Network",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "load-sut" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 10,
