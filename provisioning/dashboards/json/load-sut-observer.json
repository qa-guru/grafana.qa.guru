      "targets": [
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "rate(node_disk_read_bytes_total{device!~\"loop.*|sr.*|ram.*\"}[5m])", "legendFormat": "read {{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "rate(node_disk_written_bytes_total{device!~\"loop.*|sr.*|ram.*\"}[5m])", "legendFormat": "write {{device}}", "refId": "B" }
      ],
      "title": "Disk I/O",
      "type": "timeseries"
    }
