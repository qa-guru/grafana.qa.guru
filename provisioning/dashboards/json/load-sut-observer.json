      "targets": [{ "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "sum(up)", "legendFormat": "up", "refId": "A" }],
      "title": "up (jobs)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "load-sut" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
