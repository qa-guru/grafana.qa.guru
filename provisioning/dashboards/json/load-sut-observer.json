      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "node_load1", "legendFormat": "load1", "refId": "A" }],
      "title": "load1 (2 vCPU)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "load-sut" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "cpu busy", "refId": "A" }],
      "title": "CPU busy",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "load-sut" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "node_load1", "legendFormat": "load1", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "node_load5", "legendFormat": "load5", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "node_load15", "legendFormat": "load15", "refId": "C" }
      ],
      "title": "Load average",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "load-sut" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "load-sut" }, "expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "refId": "B" }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "load-sut" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 9,
